{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EchoWorker/EchoChannelHub/main/schemas/channel-source-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "publisher", "id", "name", "version", "summary", "description", "aliases", "categoryIds", "tagIds", "license", "runtime", "runtimeLabel", "entrypoint", "target", "capabilities", "highlights", "publisherTrust", "setupMethod", "provenance"],
  "properties": {
    "$schema": { "type": "string" }, "schemaVersion": { "const": 1 }, "publisher": { "type": "string", "minLength": 1 }, "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "$ref": "#/$defs/localized" }, "version": { "type": "string" }, "summary": { "$ref": "#/$defs/localized" }, "description": { "$ref": "#/$defs/localized" },
    "aliases": { "$ref": "#/$defs/strings" }, "categoryIds": { "$ref": "#/$defs/strings" }, "tagIds": { "$ref": "#/$defs/strings" }, "license": { "type": "string" },
    "runtime": { "const": "node" }, "runtimeLabel": { "$ref": "#/$defs/localized" }, "entrypoint": { "type": "string" }, "target": { "const": "windows-x64" },
    "capabilities": { "$ref": "#/$defs/strings" }, "highlights": { "type": "array", "items": { "$ref": "#/$defs/localized" } }, "publisherTrust": { "enum": ["community", "official"] },
    "setupMethod": { "$ref": "#/$defs/localized" }, "provenance": { "type": "string" }
  },
  "$defs": {
    "localized": { "type": "object", "additionalProperties": false, "required": ["en", "zh-CN"], "properties": { "en": { "type": "string", "minLength": 1 }, "zh-CN": { "type": "string", "minLength": 1 } } },
    "strings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
