{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EchoWorker/EchoChannelHub/main/schemas/catalog-v1.schema.json",
  "title": "EchoChannelHub catalog v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "sequence", "generatedAt", "expiresAt", "channels"],
  "properties": { "schemaVersion": { "const": 1 }, "sequence": { "type": "integer", "minimum": 0 }, "generatedAt": { "type": "string", "format": "date-time" }, "expiresAt": { "type": "string", "format": "date-time" }, "channels": { "type": "array", "items": { "$ref": "#/$defs/channel" } } },
  "$defs": {
    "localized": { "type": "object", "additionalProperties": false, "required": ["en", "zh-CN"], "properties": { "en": { "type": "string", "minLength": 1 }, "zh-CN": { "type": "string", "minLength": 1 } } },
    "strings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "channel": { "type": "object", "additionalProperties": false, "required": ["publisher", "id", "name", "summary", "description", "aliases", "categoryIds", "tagIds", "capabilities", "highlights", "publisherTrust", "setupMethod", "runtime", "releases"], "properties": { "publisher": { "type": "string" }, "id": { "type": "string" }, "name": { "$ref": "#/$defs/localized" }, "summary": { "$ref": "#/$defs/localized" }, "description": { "$ref": "#/$defs/localized" }, "aliases": { "$ref": "#/$defs/strings" }, "categoryIds": { "$ref": "#/$defs/strings" }, "tagIds": { "$ref": "#/$defs/strings" }, "capabilities": { "$ref": "#/$defs/strings" }, "highlights": { "type": "array", "items": { "$ref": "#/$defs/localized" } }, "publisherTrust": { "type": "string" }, "setupMethod": { "$ref": "#/$defs/localized" }, "runtime": { "$ref": "#/$defs/localized" }, "releases": { "type": "array", "items": { "$ref": "#/$defs/release" } } } },
    "release": { "type": "object", "additionalProperties": false, "required": ["version", "status", "engines", "artifacts"], "properties": { "version": { "type": "string" }, "status": { "enum": ["active", "yanked", "revoked"] }, "engines": { "type": "object" }, "artifacts": { "type": "object", "additionalProperties": false, "required": ["windows-x64"], "properties": { "windows-x64": { "$ref": "#/$defs/artifact" } } } } },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["url", "size", "sha256", "signature", "keyId"], "properties": { "url": { "type": "string", "pattern": "^https://" }, "size": { "type": "integer", "minimum": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "signature": { "type": "string", "minLength": 1 }, "keyId": { "type": "string", "minLength": 1 } } }
  }
}
