{
  "$schema": "../../schemas/channel-source-v2.schema.json",
  "schemaVersion": 2,
  "publisher": "EchoWorker",
  "id": "wechat",
  "name": {
    "en": "WeChat",
    "zh-CN": "微信"
  },
  "version": "0.1.10",
  "summary": {
    "en": "WeChat channel for EchoAI.",
    "zh-CN": "EchoAI 微信通道。"
  },
  "description": {
    "en": "Connect EchoAI to WeChat through guided QR-code setup and exchange text, images, and audio.",
    "zh-CN": "通过二维码引导配置将 EchoAI 连接到微信，并收发文本、图片和音频。"
  },
  "aliases": [
    "wechat",
    "wx"
  ],
  "categoryIds": [
    "messaging"
  ],
  "tagIds": [
    "direct-message",
    "media",
    "multi-account"
  ],
  "license": "MIT",
  "runtime": "node",
  "runtimeLabel": {
    "en": "Bundled Node.js runtime",
    "zh-CN": "内置 Node.js 运行时"
  },
  "entrypoint": "dist/cli.js",
  "target": "windows-x64",
  "capabilities": [
    "media",
    "receive",
    "send"
  ],
  "highlights": [
    {
      "en": "Guided QR-code setup",
      "zh-CN": "二维码引导配置"
    },
    {
      "en": "Text, image, and audio messaging",
      "zh-CN": "文本、图片和音频消息"
    }
  ],
  "publisherTrust": "official",
  "setupMethod": {
    "en": "Guided setup window",
    "zh-CN": "引导式配置窗口"
  },
  "setup": {
    "args": [
      "setup",
      "--echowork-json",
      "--session-id",
      "{sessionId}"
    ],
    "add": {
      "args": [
        "--mode",
        "add"
      ]
    },
    "restore": {
      "args": [
        "--mode",
        "restore",
        "--account",
        "{profileId}"
      ]
    },
    "startArgs": [
      "start",
      "--account",
      "{profileId}"
    ],
    "env": {}
  },
  "provenance": "MIGRATION.json"
}
